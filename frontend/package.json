{
  "name": "popcorn-society-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "start": "vite",
    "preview": "vite preview --host localhost --port 3000",
    "build": "yarn typecheck && vite build",
    "typecheck": "yarn typecheck:app && yarn typecheck:node && yarn typecheck:e2e",
    "typecheck:app": "tsc --noEmit",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "yarn typecheck:e2e && playwright test",
    "e2e:headed": "yarn typecheck:e2e && playwright test --headed",
    "e2e:install": "playwright install chromium",
    "e2e:ui": "yarn typecheck:e2e && playwright test --ui",
    "lint": "yarn lint:fast && eslint .",
    "lint:fast": "oxlint --type-aware --type-check .",
    "format": "yarn prettier --write .",
    "brand:assets": "node scripts/generate-brand-assets.ts",
    "checkUpdates": "ncu",
    "updateOpenApiSpec": "curl ${POPCORN_SOCIETY_OPENAPI_BASE_URL:-http://localhost:8080}/v3/api-docs.yaml > ./src/client/popcorn-society-backend.yaml",
    "build:moviesGen": "openapi-generator-cli generate -i ./src/client/popcorn-society-backend.yaml -g typescript-axios -t ./openapi-templates/typescript-axios -o ./src/client/movies/generator-output/"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource/bebas-neue": "^5",
    "@github/webauthn-json": "^2.1.1",
    "@hookform/resolvers": "5.2.2",
    "@mui/icons-material": "9.0.1",
    "@mui/material": "9.0.1",
    "@tanstack/react-query": "^5.100.9",
    "axios": "1.20.0",
    "notistack": "^3.0.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "7.75.0",
    "react-image-crop": "11.0.10",
    "react-markdown": "^10.1.0",
    "react-router": "7.18.2",
    "web-vitals": "5.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "10.0.1",
    "@openapitools/openapi-generator-cli": "2.41.0",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "24.12.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "10.3.0",
    "eslint-plugin-oxlint": "^1.83.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-testing-library": "7.16.2",
    "globals": "17.6.0",
    "jsdom": "^27.3.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "prettier": "^3.8.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "8.59.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "resolutions": {
    "@babel/core": "7.29.7",
    "@babel/runtime": "7.29.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "axios": "1.20.0",
    "brace-expansion": "5.0.12",
    "form-data": "4.0.6",
    "ip-address": "10.7.1",
    "ws": "8.21.3"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
